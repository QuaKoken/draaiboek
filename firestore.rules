rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /draaiboeken/{boek} {
      allow get, create: if boek in ["eb67d8a4fc08e4b6bade9648e482cbc4d29f8224", "b00fd88b7144f3d35e3676735f742ab8ccefbefd"];
      match /acties/{actie} {
        allow read, delete: if boek in ["eb67d8a4fc08e4b6bade9648e482cbc4d29f8224", "b00fd88b7144f3d35e3676735f742ab8ccefbefd"];
        allow create, update: if boek in ["eb67d8a4fc08e4b6bade9648e482cbc4d29f8224", "b00fd88b7144f3d35e3676735f742ab8ccefbefd"]
          && request.resource.data.keys().hasOnly(['titel','eigenaar','deadline','status','notitie','volgorde','door','gewijzigd'])
          && request.resource.data.titel is string && request.resource.data.titel.size() <= 300
          && request.resource.data.status in ['open','bezig','klaar'];
      }
    }
  }
}
